{
  "name": "public-notice-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "vite preview",
    "test:watch": "vitest",
    "ingest:councils": "tsx scripts/ingestCouncils.ts",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.536.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "@supabase/supabase-js": "^2.46.0",
    "react-dropzone": "^14.3.8",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "lodash.debounce": "^4.0.8",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.0.4",
    "busboy": "^1.6.0",
    "textract": "^2.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "24.2.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^1.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "jsdom": "^24.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@typescript-eslint/parser": "^8.35.1",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "eslint-config-prettier": "^9.1.0",
    "@types/cors": "^2.8.17",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,css,html,json}": [
      "prettier --write"
    ]
  }
}
