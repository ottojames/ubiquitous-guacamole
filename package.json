{
  "name": "public-notice-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "run-p dev:web dev:server",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "run-p dev:web dev:server",
    "build": "vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "start": "vite preview --port 5173 --strictPort",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --run --coverage",
    "coverage:ci": "CI=1 vitest --run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest:councils": "tsx scripts/ingestCouncils.ts",
    "backfill:locations": "tsx scripts/backfillNoticeLocations.ts",
    "test:scraper": "tsx server/jobs/testScraper.ts",
    "smoke:api": "node -e \"(async()=>{const h=await fetch('http://localhost:5174/api/health');console.log('health:',await h.json());const s=await fetch('http://localhost:5174/api/addresses?q=9%20lower');console.log('sample:',await s.json())})().catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-popover": "^1.0.7",
