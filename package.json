    "helmet": "^7.1.0",
    "lodash.debounce": "^4.0.8",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.536.0",
    "mammoth": "^1.10.0",
    "maplibre-gl": "^4.3.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.13",
    "openai": "^6.3.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.5.4",
    "pdfkit": "^0.14.0",
