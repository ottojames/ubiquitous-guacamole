SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=notices
ADDRESS_PROVIDER=mock
PORT=5175

# Map tiles (MapLibre)
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY

# Optional postcode API override
POSTCODES_IO_URL=https://api.postcodes.io

# Email service (Resend)
RESEND_API_KEY=

# Stripe payments - Get your keys from https://dashboard.stripe.com/apikeys
# Frontend (publishable key - safe to expose in browser)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Backend (secret key - NEVER expose to frontend)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret - Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Application URL (used for Stripe return URLs, email links)
VITE_APP_URL=http://localhost:5173

# Error tracking (Sentry) - Get your DSN from https://sentry.io
# Frontend (Vite environment variables must start with VITE_)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Backend
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
