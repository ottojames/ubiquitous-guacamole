+import * as React from 'react';
+import { useNavigate } from 'react-router-dom';
+
+import AddressSearch, { type AddressSelection } from '@/components/common/AddressSearch';
+import { compressPostcode, mapPostcodeToCouncil, normalisePostcode } from '@/lib/address';
+import { createDraftNotice } from '@/lib/notices';
+
+export default function HomeRoute() {
+  const navigate = useNavigate();
+  const [submitting, setSubmitting] = React.useState(false);
+  const [feedback, setFeedback] = React.useState<string | null>(null);
+
+  const handleSelected = React.useCallback(
+    async ({ suggestion, address }: AddressSelection) => {
+      const rawPostcode = address.postcode || suggestion.postcode || suggestion.label;
+      let normalisedPostcode = normalisePostcode(rawPostcode);
+
+      if (!normalisedPostcode && suggestion.label) {
+        const fromLabel = suggestion.label
+          .split(',')
+          .map((segment) => normalisePostcode(segment))
+          .find((segment): segment is string => Boolean(segment));
+        normalisedPostcode = fromLabel ?? null;
+      }
+
+      if (!normalisedPostcode) {
+        setFeedback('We could not detect a postcode for that address yet. Try searching with the postcode.');
+        return;
+      }
+
+      const council = mapPostcodeToCouncil(normalisedPostcode);
+      if (!council?.id) {
+        setFeedback('We do not support that council yet. Try another address or contact support.');
+        return;
+      }
+
+      setSubmitting(true);
+      setFeedback(null);
+
+      try {
+        const preparedAddress = { ...address, postcode: normalisedPostcode };
+        const payload = {
+          address: preparedAddress,
+          postcode: compressPostcode(normalisedPostcode) ?? normalisedPostcode.replace(/\s+/g, ''),
+          councilId: council.id,
+        };
+        const response = await createDraftNotice(payload);
+        const draftId = response.id;
+
+        navigate(`/publish?draft=${encodeURIComponent(draftId)}` , {
+          state: {
+            draftId,
+            address: preparedAddress,
+            council,
+            postcode: normalisedPostcode,
+            source: 'home-search',
+          },
+        });
+      } catch (error) {
+        console.warn('[home] failed to create draft notice', error);
